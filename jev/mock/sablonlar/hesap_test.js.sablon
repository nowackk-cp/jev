// Hesap makinesi davranış testleri: node hesap.test.js
const assert = require("assert");
const Hesap = require("./hesap.js");

function yaz(tuslar) {
  const d = Hesap.yeni();
  let ekran = d.ekran;
  for (const t of tuslar) ekran = Hesap.tus(d, t);
  return ekran;
}

const durumlar = [
  ["12+7=", "19"],
  ["9-4=", "5"],
  ["6*7=", "42"],
  ["8/2=", "4"],
  ["1.5+1.5=", "3"],
  ["0.1+0.2=", "0.3"],
  ["5/0=", "Hata"],
  ["2+3*4=", "20"],
  ["7C", "0"],
];
for (const [tuslar, beklenen] of durumlar) {
  assert.strictEqual(yaz(tuslar), beklenen, `${tuslar} → ${beklenen} bekleniyordu`);
}
console.log(`hesap testleri geçti (${durumlar.length}/${durumlar.length})`);
